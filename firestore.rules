rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function authed() {
      return request.auth != null;
    }

    function userGarage() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.garageId;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isGarageStaff() {
      return authed() && ['AdminGarage', 'Manager', 'SuperAdmin'].includes(userRole());
    }

    // Document déjà en base (read / update / delete)
    function inMyGarage(existing) {
      return authed() && userGarage() == existing.garageId;
    }

    // Users can only access their own user document
    match /users/{userId} {
      allow read, write: if authed() && request.auth.uid == userId;
    }

    // Garage isolation - users can only access data from their garage
    match /garages/{garageId} {
      allow read, write: if authed() && userGarage() == garageId;
    }

    // Collections isolées par garage.
    // A la creation, `resource` est null : il faut comparer request.resource.data.
    match /clients/{clientId} {
      allow read, update, delete: if inMyGarage(resource.data);
      allow create: if inMyGarage(request.resource.data);
    }

    match /vehicles/{vehicleId} {
      allow read, update, delete: if inMyGarage(resource.data);
      allow create: if inMyGarage(request.resource.data);
    }

    match /visits/{visitId} {
      allow read, update, delete: if inMyGarage(resource.data);
      allow create: if inMyGarage(request.resource.data);
    }

    match /diagnostics/{diagnosticId} {
      allow read, update, delete: if inMyGarage(resource.data);
      allow create: if inMyGarage(request.resource.data);
    }

    match /quotes/{quoteId} {
      allow read, update, delete: if inMyGarage(resource.data);
      allow create: if inMyGarage(request.resource.data);
    }

    match /interventions/{interventionId} {
      allow read, update, delete: if inMyGarage(resource.data);
      allow create: if inMyGarage(request.resource.data);
    }

    match /invoices/{invoiceId} {
      allow read, update, delete: if inMyGarage(resource.data);
      allow create: if inMyGarage(request.resource.data);
    }

    match /payments/{paymentId} {
      allow read, update, delete: if inMyGarage(resource.data);
      allow create: if inMyGarage(request.resource.data);
    }

    match /reports/{reportId} {
      allow read, update, delete: if inMyGarage(resource.data);
      allow create: if inMyGarage(request.resource.data);
    }

    match /garagePrintTemplates/{templateId} {
      allow read, update, delete: if inMyGarage(resource.data);
      allow create: if inMyGarage(request.resource.data);
    }

    // Categorias de diagnostic : liseuses et ecrites par les membres du garage
    // (ecran « Checks diagnostiques »).
    match /diagnosticCategory/{categoryId} {
      allow read, update, delete: if inMyGarage(resource.data);
      allow create: if inMyGarage(request.resource.data);
    }

    // Personnel : lu par les selecteurs de techniciens (diagnostics, interventions),
    // ecrit seulement par le staff du garage.
    match /personnel/{personnelId} {
      allow read: if inMyGarage(resource.data);
      allow create: if isGarageStaff() && inMyGarage(request.resource.data);
      allow update: if isGarageStaff() && inMyGarage(resource.data) && inMyGarage(request.resource.data);
      allow delete: if isGarageStaff() && inMyGarage(resource.data);
    }
  }
}
